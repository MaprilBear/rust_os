// Platform description for the kernel: Renode's stock nRF52840 SoC.
//
// Provides (see platforms/cpus/nrf52840.repl in the Renode install):
//   Cortex-M4 + NVIC @ 0xE000E000, flash 1 MiB @ 0x0, RAM 256 KiB @ 0x20000000,
//   UARTE0 @ 0x40002000, UARTE1 @ 0x40028000, RTC0-2, TIMER0-4, GPIO P0/P1,
//   GPIOTE, TWI, SPI, PPI, EGU0-5, RNG, ECB, RADIO, I2S, PDM, WDT, CLOCK.
//
// Add board-level things (LEDs, buttons, extra devices) below this line.
using "platforms/cpus/nrf52840.repl"

// Debug console for quick-and-dirty printing (src/debugcon.rs). A write to this
// 4-byte register prints a character; a '\n' flushes the line to the Renode log
// as "debugcon: <line>". It is not part of the real chip. Address must match
// DEBUGCON in src/debugcon.rs. If Renode cannot find the script, use an absolute
// path (e.g. "/work/renode/debugcon.py").
debugcon: Python.PythonPeripheral @ sysbus 0x60000000
    size: 0x4
    initable: true
    filename: "/work/renode/debugcon.py"

nvic:
    systickFrequency: 64000000